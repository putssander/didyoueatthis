# Copy to .env (git-ignored). Only the providers you set keys for are offered.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: an OpenAI-compatible local server (vLLM, Ollama, llama.cpp) for open-weight models.
# Local models are the only endpoints the runner lets receive material from the `restricted` tier in full.
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_API_KEY=ollama
